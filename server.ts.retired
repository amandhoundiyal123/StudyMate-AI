function loadStudentProfile(): any {
  try {
    if (!fs.existsSync(DATA_DIR)) {
      fs.mkdirSync(DATA_DIR, { recursive: true });
    }
    if (fs.existsSync(PROFILE_FILE)) {
      const data = JSON.parse(fs.readFileSync(PROFILE_FILE, 'utf-8'));
      const existingBadgeIds = new Set((data.badges || []).map((b: any) => b.id));
      for (const ib of INITIAL_BADGES) {
        if (!existingBadgeIds.has(ib.id)) {
          data.badges.push({ ...ib });
        }
      }
      return data;
    }
  } catch (err) {
    console.error('Error loading student profile, resetting to default:', err);
  }

  const today = new Date().toISOString().split('T')[0];
  const initial = {
    xp: 0,
    study_days: [today],
    completed_activities: [],
    quiz_attempts: [],
    badges: INITIAL_BADGES,
    topic_mastery: {},
  };
  saveStudentProfile(initial);
  return initial;
}

function saveStudentProfile(data: any) {
  try {
    if (!fs.existsSync(DATA_DIR)) {
      fs.mkdirSync(DATA_DIR, { recursive: true });
    }
    fs.writeFileSync(PROFILE_FILE, JSON.stringify(data, null, 2), 'utf-8');
  } catch (err) {
    console.error('Error saving student profile:', err);
  }
}

app.get('/student/profile', (_req: Request, res: Response) => {
  const profile = loadStudentProfile();
  const level = getLevelInfo(profile.xp);
  res.json({
    ...profile,
    level,
  });
});

app.post('/student/record-quiz', (req: Request, res: Response) => {
  const { session_id, quiz_id, topic, results } = req.body || {};
  if (!quiz_id) {
    res.status(400).json({ detail: 'quiz_id is required' });
    return;
  }

  const profile = loadStudentProfile();

  // Prevent duplicate XP: if quiz_id is already in completed_activities
  if (profile.completed_activities.includes(quiz_id)) {
    const level = getLevelInfo(profile.xp);
    res.json({
      profile: { ...profile, level },
      xp_earned: 0,
      leveled_up: false,
      new_badges: [],
      is_duplicate: true,
    });
    return;
  }

  const totalQuestions = Array.isArray(results) ? results.length : 0;
  const correctCount = Array.isArray(results)
    ? results.filter((r: any) => r.evaluation?.is_correct).length
    : 0;

  const scorePercent = totalQuestions > 0 ? Math.round((correctCount / totalQuestions) * 100) : 0;

  // Check for comeback on this topic
  const previousAttempts = (profile.quiz_attempts || []).filter(
    (a: any) => (a.topic || '').toLowerCase() === (topic || '').toLowerCase()
  );
  let isComeback = false;
  if (previousAttempts.length > 0) {
    const lastScore = previousAttempts[previousAttempts.length - 1].score_percent;
    if (scorePercent > lastScore) {
      isComeback = true;
    }
  }

  const xpEarned = calculateQuizXp(correctCount, totalQuestions, isComeback);
  const oldXp = profile.xp;
  const oldLevel = getLevelInfo(oldXp);

  profile.xp += xpEarned;
  const newLevel = getLevelInfo(profile.xp);
  const leveledUp = newLevel.level > oldLevel.level;

  profile.completed_activities.push(quiz_id);

  const today = new Date().toISOString().split('T')[0];
  if (!profile.study_days.includes(today)) {
    profile.study_days.push(today);
  }

  // Record wrong questions for review
  const wrongQuestions = (results || [])
    .filter((r: any) => !r.evaluation?.is_correct)
    .map((r: any) => ({
      id: r.question?.id || crypto.randomUUID(),
      question: r.question?.question || '',
      selected_option_id: r.selected_option_id || '',
      selected_option_text:
        r.question?.options?.find((o: any) => o.id === r.selected_option_id)?.text || '',
      correct_option_id: r.evaluation?.correct_option_id || '',
      correct_option_text: r.evaluation?.correct_option_text || '',
      explanation: r.evaluation?.explanation || '',
      page_number: r.evaluation?.source_citation?.page_number,
      passage: r.evaluation?.source_citation?.passage,
    }));

  profile.quiz_attempts.push({
    id: quiz_id,
    session_id,
    topic: topic || 'General Notes',
    total_questions: totalQuestions,
    correct_count: correctCount,
    score_percent: scorePercent,
    timestamp: new Date().toISOString(),
    is_comeback: isComeback,
    wrong_questions: wrongQuestions,
  });

  // Update Topic Mastery
  const topicKey = topic || 'General Notes';
  const existingMastery = profile.topic_mastery[topicKey] || {
    topic: topicKey,
    total_quizzes: 0,
    total_questions: 0,
    total_correct: 0,
    average_score: 0,
    status: 'Insufficient Data',
    last_attempt_date: today,
    wrong_questions: [],
  };

  existingMastery.total_quizzes += 1;
  existingMastery.total_questions += totalQuestions;
  existingMastery.total_correct += correctCount;
  existingMastery.average_score = Math.round(
    (existingMastery.total_correct / existingMastery.total_questions) * 100
  );
  existingMastery.status = calculateTopicMasteryStatus(
    existingMastery.average_score,
    existingMastery.total_quizzes
  );
  existingMastery.last_attempt_date = today;
  existingMastery.wrong_questions = [
    ...wrongQuestions,
    ...(existingMastery.wrong_questions || []),
  ].slice(0, 30);

  profile.topic_mastery[topicKey] = existingMastery;

  // Award badges
  const newBadges: any[] = [];
  const nowStr = new Date().toLocaleDateString(undefined, {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });

  const totalQuizzes = profile.quiz_attempts.length;

  for (const b of profile.badges) {
    if (b.unlocked) continue;
    let shouldUnlock = false;

    if (b.id === 'first_steps' && totalQuizzes >= 1) {
      shouldUnlock = true;
    } else if (b.id === 'quiz_explorer' && totalQuizzes >= 10) {
      shouldUnlock = true;
    } else if (b.id === 'perfect_recall' && scorePercent === 100) {
      shouldUnlock = true;
    } else if (b.id === 'comeback' && isComeback) {
      shouldUnlock = true;
    } else if (b.id === 'consistent_learner' && profile.study_days.length >= 5) {
      shouldUnlock = true;
    } else if (b.id === 'topic_master') {
      const isAnyMaster = Object.values(profile.topic_mastery).some(
        (m: any) => m.total_quizzes >= 2 && m.average_score >= 80
      );
      if (isAnyMaster) shouldUnlock = true;
    }

    if (shouldUnlock) {
      b.unlocked = true;
      b.unlocked_at = nowStr;
      newBadges.push({ ...b });
    }
  }

  saveStudentProfile(profile);

  res.json({
    profile: { ...profile, level: newLevel },
    xp_earned: xpEarned,
    leveled_up: leveledUp,
    new_level: leveledUp ? newLevel : undefined,
    new_badges: newBadges,
    is_duplicate: false,
  });
});

app.post('/student/record-revision', (req: Request, res: Response) => {
  const { session_id, topic } = req.body || {};
  if (!session_id) {
    res.status(400).json({ detail: 'session_id is required' });
    return;
  }

  const profile = loadStudentProfile();
  const today = new Date().toISOString().split('T')[0];
  const activityKey = `revision_${session_id}_${today}`;

  if (profile.completed_activities.includes(activityKey)) {
    const level = getLevelInfo(profile.xp);
    res.json({
      profile: { ...profile, level },
      xp_earned: 0,
      leveled_up: false,
      is_duplicate: true,
    });
    return;
  }

  const xpEarned = 25;
  const oldLevel = getLevelInfo(profile.xp);
  profile.xp += xpEarned;
  const newLevel = getLevelInfo(profile.xp);
  const leveledUp = newLevel.level > oldLevel.level;

  profile.completed_activities.push(activityKey);
  if (!profile.study_days.includes(today)) {
    profile.study_days.push(today);
  }

  saveStudentProfile(profile);

  res.json({
    profile: { ...profile, level: newLevel },
    xp_earned: xpEarned,
    leveled_up: leveledUp,
    new_level: leveledUp ? newLevel : undefined,
    is_duplicate: false,
  });
});

app.post('/student/flashcards', async (req: Request, res: Response) => {
  try {
    const { topic, session_id } = req.body || {};
    let textToUse = '';
    let pageNum = 1;

    if (session_id && sessions.has(session_id)) {
      const s = sessions.get(session_id)!;
      textToUse = s.chunks.map((c) => c.text).join('\n\n').slice(0, 3000);
      pageNum = s.chunks[0]?.page_number || 1;
    } else {
      for (const s of sessions.values()) {
        if (s.topic.toLowerCase() === (topic || '').toLowerCase()) {
          textToUse = s.chunks.map((c) => c.text).join('\n\n').slice(0, 3000);
          pageNum = s.chunks[0]?.page_number || 1;
          break;
        }
      }
    }

    if (!textToUse) {
      textToUse = `Study topic: ${topic}. Focus on key definitions, core concepts, and formulas.`;
    }

    const ai = getAiClient();
    if (!ai) {
      res.status(503).json({ detail: 'AI inference client not configured' });
      return;
    }

    const prompt = `You are StudyMate AI flashcard maker.
Create 5 high-yield study flashcards for the topic: "${topic}".
Each card has a 'front' (term or key question) and a 'back' (concise clear definition or answer).
Return ONLY a valid JSON array:
[
  {
    "id": "fc1",
    "front": "Term or Key Question",
    "back": "Clear definition or answer grounded in study notes",
    "page_number": ${pageNum}
  }
]

Content excerpts:
${textToUse}

JSON array:`;

    const cacheKey = (topic || '').trim().toLowerCase();
    if (cacheKey && flashcardsCache.has(cacheKey)) {
      res.json({
        topic,
        flashcards: flashcardsCache.get(cacheKey),
      });
      return;
    }

    const aiRes = await callAiWithFastFallback({ prompt, isJson: true });
    const raw = aiRes.text;
    const jsonMatch = raw.match(/\[\s*\{[\s\S]*\}\s*\]/);
    const jsonStr = jsonMatch ? jsonMatch[0] : raw;
    let flashcards = [];
    try {
      flashcards = JSON.parse(jsonStr);
    } catch {
      flashcards = [
        {
          id: 'fc1',
          front: `What is the core principle of ${topic}?`,
          back: `The fundamental mechanism defined in your notes.`,
          page_number: pageNum,
        },
      ];
    }

    if (cacheKey && Array.isArray(flashcards) && flashcards.length > 0) {
      flashcardsCache.set(cacheKey, flashcards);
    }

    res.json({
      topic,
      flashcards,
    });
  } catch (err: any) {
    res.status(500).json({ detail: `Flashcard generation failed: ${err.message}` });
  }
});

// Mount Vite middlewares for development frontend
async function startServer() {
  if (process.env.NODE_ENV !== 'production') {
    const { createServer } = await import('vite');
    const vite = await createServer({
      server: { middlewareMode: true },
      appType: 'spa',
    });
    app.use(vite.middlewares);
  }

  app.listen(port, '0.0.0.0', () => {
    console.log(`StudyMate AI Server running on http://0.0.0.0:${port}`);
  });
}

startServer().catch(console.error);

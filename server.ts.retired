});

app.post('/upload-notes', upload.single('file'), async (req: Request, res: Response) => {
  try {
    const file = req.file;
    const bodyText = (req.body?.text || '').trim();
    const topic = (req.body?.topic || '').trim() || 'General Study Notes';

    if (!file && !bodyText) {
      res.status(400).json({ detail: 'Please provide either a PDF file or paste text notes to begin studying.' });
      return;
    }

    let chunks: Chunk[] = [];
    let documentName = 'Study Notes';
    let totalPages = 1;

    if (file) {
      documentName = file.originalname || 'document.pdf';
      if (!documentName.toLowerCase().endsWith('.pdf')) {
        res.status(400).json({ detail: 'Unsupported file format. Please upload a standard PDF (.pdf) document.' });
        return;
      }
      if (!file.buffer || file.buffer.length === 0) {
        res.status(400).json({ detail: 'The uploaded PDF file is empty (0 bytes).' });
        return;
      }

      try {
        const parser = new PDFParse(new Uint8Array(file.buffer));
        const pdfData = await parser.getText();
        const pages = pdfData.pages || [];

        if (pages.length === 0 && !pdfData.text) {
          res.status(400).json({ detail: 'The uploaded PDF has 0 readable pages.' });
          return;
        }

        if (pages.length > 0) {
          totalPages = pages.length;
          pages.forEach((pageObj: any, idx: number) => {
            const pageText = (pageObj.text || '').trim();
            if (pageText) {
              const pageChunks = splitTextIntoChunks(pageText, documentName, idx + 1, chunks.length + 1);
              chunks.push(...pageChunks);
            }
          });
        } else if (pdfData.text) {
          chunks = splitTextIntoChunks(pdfData.text, documentName, 1, 1);
        }

        if (chunks.length === 0) {
          res.status(400).json({
            detail: 'No readable text could be extracted from this PDF. Please ensure it is not a scanned image-only PDF.',
          });
          return;
        }
      } catch (err: any) {
        res.status(400).json({ detail: `Corrupted or invalid PDF file: ${err.message}` });
        return;
      }
    } else if (bodyText) {
      documentName = 'Pasted Study Notes';
      const words = bodyText.split(/\s+/);
      if (words.length < 15) {
        res.status(400).json({ detail: 'Pasted notes are too short. Please provide at least 15 words of study material.' });
        return;
      }

      const wordsPerPage = 350;
      let chunkCounter = 1;
      for (let pIdx = 0; pIdx < Math.ceil(words.length / wordsPerPage); pIdx++) {
        const pageNum = pIdx + 1;
        const pageWords = words.slice(pIdx * wordsPerPage, (pIdx + 1) * wordsPerPage);
        const pageChunks = splitTextIntoChunks(pageWords.join(' '), documentName, pageNum, chunkCounter);
        chunks.push(...pageChunks);
        chunkCounter += pageChunks.length;
      }
      totalPages = Math.max(...chunks.map((c) => c.page_number), 1);
    }

    const sessionId = crypto.randomUUID();
    const newSession: StudySession = {
      session_id: sessionId,
      topic,
      document_name: documentName,
      total_pages: totalPages,
      chunks,
      created_at: Date.now(),
      quizzes: {},
    };

    sessions.set(sessionId, newSession);

    res.json({
      session_id: sessionId,
      topic,
      document_name: documentName,
      total_pages: totalPages,
      total_chunks: chunks.length,
      message: `Successfully processed ${chunks.length} study passages from ${documentName}.`,
      preview_chunks: chunks.slice(0, 3),
    });
  } catch (err: any) {
    res.status(500).json({ detail: `Internal server error: ${err.message}` });
  }
});

app.post('/ask-question', async (req: Request, res: Response) => {
  try {
    const { session_id, question } = req.body || {};
    if (!session_id || !question?.trim()) {
      res.status(400).json({ detail: 'session_id and non-empty question are required.' });
      return;
    }

    const session = sessions.get(session_id);
    if (!session) {
      res.status(404).json({ detail: 'Study session not found or expired. Please upload your notes again.' });
      return;
    }

    const cleanQuestion = question.trim();
    const cacheKey = `${session_id}:${cleanQuestion.toLowerCase()}`;
    if (qaCache.has(cacheKey)) {
      res.json(qaCache.get(cacheKey));
      return;
    }

    const { sources, evidenceStatus } = retrievePassages(session.chunks, cleanQuestion, 3);

    // Rule 1: If passage retrieval detects Out of Syllabus or Not Found, strictly reject
    if (evidenceStatus === 'Out of Syllabus' || evidenceStatus === 'Not Found' || sources.length === 0) {
      const outResult = {
        session_id,
        question: cleanQuestion,
        answer:
          'Out of Syllabus: This question is not covered in your uploaded study notes or PDF document. StudyMate AI strictly prevents answering outside of your provided curriculum.',
        evidence_status: 'Out of Syllabus',
        sources: [],
      };
      qaCache.set(cacheKey, outResult);
      res.json(outResult);
      return;
    }

    const evidenceText = sources
      .map(
        (src, idx) =>
          `[Source ${idx + 1} - Page ${src.page_number} (${src.document_name})]:\n"${src.passage}"`
      )
      .join('\n\n');

    const prompt = `You are StudyMate AI, an honest academic assistant built by Team Cognify.
CRITICAL SYLLABUS GROUNDING RULE:
- You must answer ONLY if the provided Source Passages explicitly contain the factual information to answer the student's question.
- If the student's question is OUT OF SYLLABUS, unrelated to the excerpts, or cannot be fully and accurately answered using ONLY the provided excerpts, you MUST respond with EXACTLY:
OUT_OF_SYLLABUS
- NEVER use external knowledge, never extrapolate, and never guess.
- If the passages DO contain the answer, provide a clear, helpful response citing the exact page number (e.g. "According to Page X..."). Keep your explanation direct and concise (under 3 sentences).

Topic: ${session.topic}

--- PROVIDED SOURCE PASSAGES ---
${evidenceText}
--- END SOURCES ---

Student Question: ${cleanQuestion}

Answer:`;

    const aiRes = await callAiWithFastFallback({ prompt });
    const answerText = aiRes.text;

    // Check if model flagged out of syllabus or hallucination fallback
    if (
      !answerText ||
      answerText.includes('OUT_OF_SYLLABUS') ||
      answerText.toLowerCase().includes('not contained in the provided') ||
      answerText.toLowerCase().includes('not mentioned in the provided')
    ) {
      const rejectResult = {
        session_id,
        question: cleanQuestion,
        answer:
          'Out of Syllabus: This question is not covered in your uploaded study notes or PDF document. StudyMate AI strictly prevents answering outside of your provided curriculum.',
        evidence_status: 'Out of Syllabus',
        sources: [],
      };
      qaCache.set(cacheKey, rejectResult);
      res.json(rejectResult);
      return;
    }

    const validResult = {
      session_id,
      question: cleanQuestion,
      answer: answerText,
      evidence_status: evidenceStatus,
      sources,
    };
    qaCache.set(cacheKey, validResult);
    res.json(validResult);
  } catch (err: any) {
    res.status(503).json({ detail: `Inference error with Gemma 4: ${err.message}` });
  }
});

app.post('/generate-quiz', async (req: Request, res: Response) => {
  try {
    const { session_id, num_questions = 5, difficulty = 'Medium' } = req.body || {};
    const session = sessions.get(session_id);
    if (!session) {
      res.status(404).json({ detail: 'Study session not found or expired.' });
      return;
    }

    const ai = getAiClient();
    if (!ai) {
      res.status(503).json({ detail: 'GEMINI_API_KEY is not configured in the backend environment.' });
      return;
    }

    const requestedCount = Math.min(Math.max(Number(num_questions) || 5, 3), 10);
    const validDifficulty = ['Easy', 'Medium', 'Hard'].includes(difficulty) ? difficulty : 'Medium';

    const step = Math.max(1, Math.floor(session.chunks.length / Math.min(session.chunks.length, 8)));
    const sampledPassages = [];
    for (let i = 0; i < session.chunks.length; i += step) {
      const c = session.chunks[i];
      sampledPassages.push(
        `[Chunk: ${c.id} | Page: ${c.page_number} | Doc: ${c.document_name}]:\n${c.text.slice(0, 500)}`
      );
      if (sampledPassages.length >= 8) break;
    }

    let difficultyInstruction = '';
    if (validDifficulty === 'Easy') {
      difficultyInstruction = 'Difficulty: Easy. Focus on direct factual recall, definitions, and key terms stated explicitly in the text.';
    } else if (validDifficulty === 'Hard') {
      difficultyInstruction = 'Difficulty: Hard. Create challenging questions requiring analytical deduction, distinguishing subtle conceptual differences, and multi-step reasoning directly grounded in the notes.';
    } else {
      difficultyInstruction = 'Difficulty: Medium. Test conceptual comprehension, operational steps, and relationships between concepts in the notes.';
    }

    const prompt = `You are StudyMate AI, an educational quiz generator.
Generate exactly ${requestedCount} high-quality multiple choice questions based SOLELY on the study notes below.
${difficultyInstruction}

Requirements:
1. Every question must be directly answerable from the provided excerpts.
2. Provide exactly 4 distinct options labeled 'A', 'B', 'C', 'D' for each question.
3. Only one option must be correct.
4. Include an explanation for why the answer is correct.
5. Specify the exact page number and passage snippet that supports the answer.
6. Return ONLY valid JSON as an array of objects with this exact structure:
[
  {
    "id": "q1",
    "question": "Question text here?",
    "options": [
      {"id": "A", "text": "Option A text"},
      {"id": "B", "text": "Option B text"},
      {"id": "C", "text": "Option C text"},
      {"id": "D", "text": "Option D text"}
    ],
    "correct_option_id": "A",
    "explanation": "Clear explanation grounded in notes...",
    "page_number": 1,
    "passage": "Excerpt from notes supporting this answer"
  }
]

Topic: ${session.topic}

Study Notes Excerpts:
${sampledPassages.join('\n\n')}

JSON output:`;

    const aiRes = await callAiWithFastFallback({ prompt, isJson: true });
    const raw = aiRes.text;
    const jsonMatch = raw.match(/\[\s*\{[\s\S]*\}\s*\]/);
    const jsonStr = jsonMatch ? jsonMatch[0] : raw;
    let items: any[] = [];
    try {
      items = JSON.parse(jsonStr);
    } catch {
      const cleaned = jsonStr.replace(/,\s*([}\]])/g, '$1');
      items = JSON.parse(cleaned);
    }

    if (!Array.isArray(items) || items.length === 0) {
      res.status(500).json({ detail: 'AI returned an invalid quiz structure.' });
      return;
    }

    const quizId = crypto.randomUUID();
    const storedRecords: Record<string, StoredQuizRecord> = {};
    const studentQuestions: any[] = [];

    items.slice(0, requestedCount).forEach((item: any, idx: number) => {
      const qId = `q${idx + 1}`;
      const correctOptionId = String(item.correct_option_id || 'A').toUpperCase().trim();
      const options = (item.options || []).map((o: any) => ({
        id: String(o.id || '').toUpperCase().trim(),
        text: String(o.text || '').trim(),
      }));

      const correctOpt = options.find((o: any) => o.id === correctOptionId);
      const citation: SourceCitation = {
        chunk_id: `quiz_ref_${qId}`,
        document_name: session.document_name,
        page_number: Number(item.page_number) || session.chunks[0].page_number,
        passage: String(item.passage || session.chunks[0].text.slice(0, 150)).trim(),
        relevance_score: 1.0,
      };

      storedRecords[qId] = {
        id: qId,
        question: String(item.question).trim(),
        options,
        correct_option_id: correctOptionId,
        correct_option_text: correctOpt?.text || correctOptionId,
        explanation: String(item.explanation || 'Based on study notes.').trim(),
        source_citation: citation,
      };

      // Mask answer key from student
      studentQuestions.push({
        id: qId,
        question: String(item.question).trim(),
        options,
      });
    });

    session.quizzes[quizId] = storedRecords;

    res.json({
      session_id,
      quiz_id: quizId,
      questions: studentQuestions,
      total_questions: studentQuestions.length,
      difficulty: validDifficulty,
    });
  } catch (err: any) {
    res.status(503).json({ detail: `Failed to generate quiz: ${err.message}` });
  }
});

app.post('/evaluate-answer', (req: Request, res: Response) => {
  const { session_id, quiz_id, question_id, selected_option_id } = req.body || {};
  const session = sessions.get(session_id);
  if (!session) {
    res.status(404).json({ detail: 'Study session not found or expired.' });
    return;
  }

  const quiz = session.quizzes[quiz_id];
  const qRecord = quiz ? quiz[question_id] : null;
  if (!qRecord) {
    res.status(404).json({ detail: 'Quiz or question record not found. Please regenerate the quiz.' });
    return;
  }

  const userChoice = String(selected_option_id || '').toUpperCase().trim();
  const correctChoice = qRecord.correct_option_id.toUpperCase().trim();
  const isCorrect = userChoice === correctChoice;

  res.json({
    is_correct: isCorrect,
    selected_option_id: userChoice,
    correct_option_id: correctChoice,
    correct_option_text: qRecord.correct_option_text,
    explanation: qRecord.explanation,
    source_citation: qRecord.source_citation,
  });
});

app.get('/sessions/:session_id', (req: Request, res: Response) => {
  const session = sessions.get(req.params.session_id);
  if (!session) {
    res.status(404).json({ detail: 'Session not found.' });
    return;
  }
  res.json({
    session_id: session.session_id,
    topic: session.topic,
    document_name: session.document_name,
    total_pages: session.total_pages,
    total_chunks: session.chunks.length,
    created_at: session.created_at,
  });
});


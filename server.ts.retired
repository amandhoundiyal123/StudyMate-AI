// Fast Multi-Model AI Engine
// gemini-3.1-flash-lite delivers ~1.3s generation with zero-thinking budget.
// Automatic fallback chain ensures high reliability if demand spikes occur.
const PRIMARY_FAST_MODEL = 'gemini-3.1-flash-lite';
const FALLBACK_MODELS = ['gemini-flash-latest', 'gemma-4-26b-a4b-it'];

function getAiClient() {
  const apiKey = process.env.GEMINI_API_KEY;
  if (!apiKey) return null;
  return new GoogleGenAI({ apiKey });
}

// In-Memory Caches for near-instant responses
const qaCache = new Map<string, any>();
const flashcardsCache = new Map<string, any>();

async function callAiWithFastFallback(params: {
  prompt: string;
  isJson?: boolean;
}): Promise<{ text: string; modelUsed: string }> {
  const ai = getAiClient();
  if (!ai) {
    throw new Error('GEMINI_API_KEY is not configured in the backend environment.');
  }

  const modelsToTry = [PRIMARY_FAST_MODEL, ...FALLBACK_MODELS];
  let lastError: any = null;

  for (const model of modelsToTry) {
    try {
      const config: any = {};
      // Set zero thinking budget for minimal latency
      if (model.includes('flash') || model.includes('gemini')) {
        config.thinkingConfig = { thinkingBudget: 0 };
      }
      if (params.isJson) {
        config.responseMimeType = 'application/json';
      }

      const response = await ai.models.generateContent({
        model,
        contents: params.prompt,
        config: Object.keys(config).length > 0 ? config : undefined,
      });

      return {
        text: response.text?.trim() || '',
        modelUsed: model,
      };
    } catch (err: any) {
      console.warn(`[FastAI] Model ${model} failed (${err.message}). Trying fallback...`);
      lastError = err;
    }
  }

  throw lastError || new Error('All AI models failed to respond.');
}


// In-Memory Session Store
interface Chunk {
  id: string;
  document_name: string;
  page_number: number;
  chunk_index: number;
  text: string;
  word_count: number;
}

interface SourceCitation {
  chunk_id: string;
  document_name: string;
  page_number: number;
  passage: string;
  relevance_score: number;
}

interface StoredQuizRecord {
  id: string;
  question: string;
  options: { id: string; text: string }[];
  correct_option_id: string;
  correct_option_text: string;
  explanation: string;
  source_citation: SourceCitation;
}

interface StudySession {
  session_id: string;
  topic: string;
  document_name: string;
  total_pages: number;
  chunks: Chunk[];
  created_at: number;
  quizzes: Record<string, Record<string, StoredQuizRecord>>;
}

const sessions = new Map<string, StudySession>();

// Comprehensive English stopwords to isolate topical keywords
const STOPWORDS = new Set([
  'a', 'about', 'above', 'according', 'after', 'again', 'against', 'all', 'am', 'an', 'and',
  'any', 'are', "aren't", 'as', 'at', 'be', 'because', 'been', 'before', 'being',
  'below', 'between', 'both', 'but', 'by', 'can', 'cannot', 'could', "couldn't", 'did',
  'do', 'does', 'doing', 'down', 'during', 'each', 'explain', 'few', 'for',
  'from', 'further', 'had', 'has', 'have', 'having', 'he', 'her', 'here',
  'hers', 'herself', 'him', 'himself', 'his', 'how', 'i', 'if', 'in', 'into',
  'is', 'it', 'its', 'itself', 'just', 'me', 'more', 'most', 'my', 'myself',
  'no', 'nor', 'not', 'now', 'of', 'off', 'on', 'once', 'only', 'or', 'other',
  'our', 'ours', 'ourselves', 'out', 'over', 'own', 'same', 'she', 'should',
  'so', 'some', 'such', 'tell', 'than', 'that', 'the', 'their', 'theirs',
  'them', 'themselves', 'then', 'there', 'these', 'they', 'this', 'those',
  'through', 'to', 'too', 'under', 'until', 'up', 'very', 'was', 'we', 'were',
  'what', 'when', 'where', 'which', 'while', 'who', 'whom', 'why', 'will', 'with',
  'would', 'you', 'your', 'yours', 'yourself', 'yourselves', 'give', 'detail',
  'describe', 'define', 'list', 'state', 'mention', 'summarize', 'please', 'briefly'
]);

function extractKeywords(text: string): string[] {
  const tokens = text.toLowerCase().match(/\b[a-z0-9_-]{2,}\b/g) || [];
  const filtered = tokens.filter((t) => !STOPWORDS.has(t) && t.length > 2);
  return filtered.length > 0 ? filtered : tokens;
}

function scoreChunk(keywords: string[], chunkText: string, rawQuery: string): { score: number; matches: number } {
  if (keywords.length === 0) return { score: 0, matches: 0 };
  const chunkLower = chunkText.toLowerCase();

  let matches = 0;
  let totalTermFreq = 0;

  for (const kw of keywords) {
    // Exact word boundary matching for keywords to avoid accidental substrings
    const regex = new RegExp(`\\b${kw}\\b`, 'gi');
    const count = (chunkLower.match(regex) || []).length;
    if (count > 0) {
      matches++;
      totalTermFreq += count;
    }
  }

  if (matches === 0) return { score: 0, matches: 0 };

  const coverage = matches / keywords.length;
  const tf = Math.log1p(totalTermFreq);
  let phraseBonus = 0;
  const cleanRaw = rawQuery.toLowerCase().replace(/[^\w\s]/g, '').trim();
  if (cleanRaw.split(/\s+/).length > 1 && chunkLower.includes(cleanRaw)) {
    phraseBonus = 0.5;
  }

  const score = coverage * 0.7 + Math.min(tf, 2.0) * 0.2 + phraseBonus;
  return { score, matches };
}

function retrievePassages(
  chunks: Chunk[],
  query: string,
  topK: number = 3
): { sources: SourceCitation[]; evidenceStatus: 'Supported' | 'Partially Supported' | 'Not Found' | 'Out of Syllabus' } {
  if (chunks.length === 0) return { sources: [], evidenceStatus: 'Out of Syllabus' };
  const keywords = extractKeywords(query);
  if (keywords.length === 0) return { sources: [], evidenceStatus: 'Out of Syllabus' };

  const scored = [];
  for (const chunk of chunks) {
    const { score, matches } = scoreChunk(keywords, chunk.text, query);
    // Stricter relevance threshold: must match meaningful keywords
    if (score >= 0.35 && matches >= 1) {
      scored.push({
        score,
        matches,
        citation: {
          chunk_id: chunk.id,
          document_name: chunk.document_name,
          page_number: chunk.page_number,
          passage: chunk.text,
          relevance_score: Math.round(score * 100) / 100,
        },
      });
    }
  }

  if (scored.length === 0) {
    return { sources: [], evidenceStatus: 'Out of Syllabus' };
  }

  scored.sort((a, b) => b.score - a.score || b.matches - a.matches);
  const topScore = scored[0].score;
  const topMatches = scored[0].matches;
  const coverage = topMatches / keywords.length;

  // Stricter coverage requirement to protect against Out of Syllabus questions
  if (topScore >= 0.70 || (coverage >= 0.6 && topMatches >= 2)) {
    return { sources: scored.slice(0, topK).map((s) => s.citation), evidenceStatus: 'Supported' };
  } else if (topScore >= 0.40 && (coverage >= 0.4 || topMatches >= 2)) {
    return { sources: scored.slice(0, topK).map((s) => s.citation), evidenceStatus: 'Partially Supported' };
  }

  // If score is weak or only matched 1 weak term among many, classify as Out of Syllabus
  return { sources: [], evidenceStatus: 'Out of Syllabus' };
}

function splitTextIntoChunks(
  text: string,
  documentName: string,
  pageNumber: number,
  startIndex: number
): Chunk[] {
  const clean = text.replace(/\s+/g, ' ').trim();
  if (!clean) return [];
  const words = clean.split(' ');
  if (words.length <= 200) {
    return [
      {
        id: `c_${startIndex}`,
        document_name: documentName,
        page_number: pageNumber,
        chunk_index: startIndex,
        text: clean,
        word_count: words.length,
      },
    ];
  }

  const chunks: Chunk[] = [];
  const chunkSize = 180;
  const overlap = 35;
  let i = 0;
  let currentIndex = startIndex;

  while (i < words.length) {
    const chunkWords = words.slice(i, i + chunkSize);
    chunks.push({
      id: `c_${currentIndex}`,
      document_name: documentName,
      page_number: pageNumber,
      chunk_index: currentIndex,
      text: chunkWords.join(' '),
      word_count: chunkWords.length,
    });
    currentIndex++;
    i += chunkSize - overlap;
  }

  return chunks;
}

